{
  "name"                  : "New WhatsApp API",
  "botName"               : "WA API Bot",
  "sessionName"           : "newsession",
  "levelLog"              : "error",
  "logFileName"           : "wa-logs.json",
  "appUrl"                : "localhost",
  "port"                  : 3000,
  "defaultCountryCode"    : 62,
  
  "username"              : "yourusername",
  "password"              : "yourpassword",
  "authRequired"          : false,
  "pairing"               : {
    "usePairingCode"      : true,
    "phoneNumber"         : ""
  },
  "features"              : {
    "autoReply"           : false,
    "readMessages"        : true,
    "chatbot"             : true,
    "typing"              : true
  },
  "timezone"              : "Asia/Jakarta",
  "googleAI"              : {
    "apiKey"              : "YOUR_GEMINI_API_KEY_HERE",
    "model"               : "gemini-2.0-flash-exp",
    "maxTokens"           : 4000,
    "temperature"         : 0.7,
    "systemPrompt"        : "Anda adalah asisten AI WhatsApp yang membantu dalam bahasa Indonesia. Berikan respons lengkap, jelas, dan ramah. Gunakan format WhatsApp dengan *bold*, _italic_, emoji, dan bullet points. Ingat konteks percakapan dan berikan jawaban yang komprehensif.",
    "defaultLanguage"     : "id",
    "maxHistoryLength"    : 20,
    "contextWindowTokens" : 32000,
    "conversationTimeout" : 1800000,
    "conversationModeTimeout" : 300000,
    "useWhatsAppFormatting": true,
    "useEmojis"           : true
  }
}
