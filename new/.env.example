# Docker Environment Variables
# Copy this to .env and customize for your deployment

# WhatsApp API Configuration
WA_USERNAME=admin
WA_PASSWORD=admin123

# Node.js Environment
NODE_ENV=production

# Optional: Override config.json settings via environment variables
# WA_PORT=3000
# WA_BOT_NAME=WhatsApp API Bot
# WA_DEFAULT_COUNTRY_CODE=62
# WA_TIMEZONE=Asia/Jakarta

# Docker specific settings
COMPOSE_PROJECT_NAME=whatsapp-api
