{
  "name": "newwaapi",
  "version": "1.3.0",
  "description": "newwaapi is an alternative mywaapi but using Baileys and yeah, it's Unofficial WhatsApp API made by me on NodeJs",
  "main": "index.js",
  "scripts": {
    "start": "node --experimental-global-webcrypto index.js",
    "dev": "node --experimental-global-webcrypto index.js --use-pairing-code",
    "setup": "node setup.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:dev": "pm2 start ecosystem.config.js --env development --watch",
    "pm2:stop": "pm2 stop whatsapp-api",
    "pm2:restart": "pm2 restart whatsapp-api",
    "pm2:reload": "pm2 reload whatsapp-api",
    "pm2:delete": "pm2 delete whatsapp-api",
    "pm2:logs": "pm2 logs whatsapp-api",
    "pm2:status": "pm2 status whatsapp-api",
    "pm2:monit": "pm2 monit",
    "pm2:setup": "./pm2.sh setup",
    "docker:build": "docker build -t whatsapp-api .",
    "docker:start": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f whatsapp-api",
    "docker:setup": "./docker.sh setup"
  },
  "author": "Yama",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yama24/newwaapi.git"
  },
  "bugs": {
    "url": "https://github.com/yama24/newwaapi/issues"
  },
  "homepage": "https://github.com/yama24/newwaapi",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.0",
    "@whiskeysockets/baileys": "^6.4.0",
    "express": "^4.18.2",
    "express-fileupload": "^1.3.1",
    "express-validator": "^6.14.0",
    "moment-timezone": "^0.6.0",
    "node-cache": "^5.1.2",
    "open": "^8.4.0",
    "pino": "^8.4.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "eslint": "^9.34.0",
    "globals": "^16.3.0"
  }
}
